# Copy this file to server/.env and fill in real values.
# Never commit the real .env file.

# SMTP connection (example uses Gmail — see note below)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Where contact form submissions get sent (defaults to SMTP_USER if omitted)
CONTACT_TO_EMAIL=your-email@gmail.com

PORT=4000

# --- Gmail note ---
# If using Gmail, you cannot use your normal account password.
# 1. Enable 2-Step Verification on the Google account.
# 2. Create an "App Password" at https://myaccount.google.com/apppasswords
# 3. Use that 16-character app password as SMTP_PASS.
#
# For other providers (SendGrid, Mailgun, Outlook, your college's SMTP,
# etc.) just set SMTP_HOST/PORT/USER/PASS to their values instead.
